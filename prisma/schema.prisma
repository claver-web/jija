datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectCategory {
  WEBSITE
  AGENTIC_AI
  FUTURE
}

enum ProjectStatus {
  LIVE
  IN_PROGRESS
  PLANNED
}

enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  TOOL
  DATABASE
  AI_ML
  OTHER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model ProfileLink {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  url       String
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Project {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  description String          @db.Text
  readme      String?         @db.Text
  liveUrl     String?
  repoUrl     String?
  techStack   String[]
  category    ProjectCategory @default(WEBSITE)
  status      ProjectStatus   @default(LIVE)
  featured    Boolean         @default(false)
  thumbnail   String?
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category])
  @@index([featured])
  @@index([order])
  @@index([slug])
}

model Experience {
  id          String    @id @default(cuid())
  company     String
  role        String
  description String    @db.Text
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  location    String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([order])
  @@index([startDate])
}

model Qualification {
  id          String   @id @default(cuid())
  degree      String
  institution String
  year        String
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model Certificate {
  id            String   @id @default(cuid())
  title         String
  issuer        String
  issueDate     DateTime
  credentialUrl String?
  imageUrl      String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([order])
}

model Skill {
  id          String        @id @default(cuid())
  name        String
  category    SkillCategory @default(OTHER)
  proficiency Int           @default(80)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category])
  @@index([order])
}

model VisitorLog {
  id        String   @id @default(cuid())
  ipHash    String
  userAgent String?
  country   String?
  city      String?
  path      String
  referrer  String?
  device    String?
  browser   String?
  os        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([ipHash, path, createdAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@index([key])
}
